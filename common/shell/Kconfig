menu "QCOM Platform Shell Modules"

config QCOM_SPI_SHELL
	bool "QCOM SPI shell"
	depends on SHELL && SPI
	help
	  Provides the qcom spi shell commands for configuring and exercising
	  the SPI controller as master or slave.

config QCOM_SHELL_ASYNC
	bool "Async shell command execution (dynamic thread pool)"
	depends on SHELL && DYNAMIC_THREAD && DYNAMIC_THREAD_ALLOC
	help
	  Provides shell_async_submit() to run shell command handlers in
	  dynamically allocated background threads.  Each submit() allocates
	  a stack from the system heap; the memory is freed when the next job
	  is submitted to the same slot (lazy reclaim via k_thread_join +
	  k_thread_stack_free).  No pre-created threads — idle cost is zero.

config SHELL_ASYNC_WORKERS
	int "Number of background worker threads"
	depends on QCOM_SHELL_ASYNC
	default 4
	range 1 8
	help
	  Each worker has its own dedicated stack (statically allocated).
	  A submitted job is assigned to the first free worker.

config SHELL_ASYNC_STACK_SIZE
	int "Per-worker stack size (bytes)"
	depends on QCOM_SHELL_ASYNC
	default 2048

config SHELL_ASYNC_PRIORITY
	int "Worker thread priority"
	depends on QCOM_SHELL_ASYNC
	default 5

config QCOM_I2C_EEPROM_SHELL
	bool "QCOM I2C EEPROM async test shell"
	depends on QCOM_SHELL_ASYNC && I2C
	help
	  Concurrent I2C EEPROM read/write tests via shell_async worker threads.
	  Target: GT24C02B (or compatible AT24Cxx) EEPROM at configurable address.
	    eeprom_test write   - write test pattern (background)
	    eeprom_test read    - read back and verify (background)
	    eeprom_test stress  - writer + reader concurrently
	    eeprom_test erase   - fill test area with 0xFF

config QCOM_I2C_SHELL
	bool "QCOM async I2C shell (replaces built-in CONFIG_I2C_SHELL)"
	depends on QCOM_SHELL_ASYNC && I2C
	help
	  Enhanced i2c shell with read/write running asynchronously via
	  shell_async worker threads.  All other commands (scan, recover,
	  speed, ...) remain synchronous.  Mutually exclusive with the
	  upstream CONFIG_I2C_SHELL — set CONFIG_I2C_SHELL=n when enabling
	  this option.

config QCOM_I2C_SHELL_BUFFER_SIZE
	int "I2C shell read/write buffer size (bytes)"
	depends on QCOM_I2C_SHELL
	default 128
	range 16 512
	help
	  Size of the per-operation data buffer allocated on the worker
	  thread stack for i2c read and write commands.

config QCOM_SPI_SHELL_BUFFER_SIZE
	int "SPI shell transfer buffer size (bytes)"
	depends on QCOM_SPI_SHELL
	default 4096
	help
	  Maximum payload size for the generic SPI shell TX/RX buffers.  Larger
	  values can be selected by applications that need large DMA transfers.

config QCOM_ACOMP_SHELL
	bool "QCOM comparator shell"
	depends on SHELL && COMPARATOR && GPIO
	help
	  Enable QCC74x comparator commands under "qcom acomp". Commands run in
	  a dedicated service thread to serialize comparator and optional
	  drive-GPIO access.

config QCOM_PSA_HASH_SHELL
	bool "PSA Hash shell commands"
	depends on SHELL
	depends on MBEDTLS_PSA_CRYPTO_C
	help
	  Enable interactive shell commands for PSA hash computation.
	  Provides 'hash oneshot/multipart/str-oneshot/str-multipart/list/help'
	  commands. Works with any active PSA hash backend (HW transparent
	  driver or SW fallback). Does not depend on a specific driver variant.

endmenu

rsource "Kconfig.pm"
