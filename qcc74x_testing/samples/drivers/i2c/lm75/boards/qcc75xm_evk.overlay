&pinctrl {
	status = "okay";
	i2c0_default: i2c0_default {
	group1 {
		pinmux = <GPIO16_I2C0_SCL>,
			<GPIO17_I2C0_SDA>;
			bias-pull-up;
			drive-strength = <1>;
			input-schmitt-enable;
			input-enable;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};