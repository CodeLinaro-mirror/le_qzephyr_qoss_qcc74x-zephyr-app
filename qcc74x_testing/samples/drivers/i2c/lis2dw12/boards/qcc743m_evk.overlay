/ {
	chosen {
		my_i2c_dev = &i2c0;
	};
};

&pinctrl {
	status = "okay";
	i2c0_default: i2c0_default {
	group1 {
		pinmux = <GPIO30_I2C0_SCL>,
			<GPIO29_I2C0_SDA>;
		bias-pull-up;
		drive-strength = <1>;
		input-schmitt-enable;
		input-enable;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};
