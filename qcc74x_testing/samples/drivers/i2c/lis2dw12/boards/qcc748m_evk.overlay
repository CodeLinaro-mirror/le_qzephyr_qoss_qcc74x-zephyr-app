/ {
	chosen {
		my_i2c_dev = &i2c1;
	};
};

&pinctrl {
	status = "okay";
	i2c1_default: i2c1_default {
	group1 {
		pinmux = <I2C1_SCL_GPIO18>,
			<I2C1_SDA_GPIO19>;
		bias-pull-up;
		drive-strength = <1>;
		input-schmitt-enable;
		input-enable;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
};
