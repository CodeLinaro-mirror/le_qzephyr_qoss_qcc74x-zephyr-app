/ {
	chosen {
	zephyr,display = &st7796s;
	};
};

&dma {
	status = "okay";
};

&mipi_dbi0 {
	status = "okay";
	dmas = <&dma 3  DMA_REQUEST_DBI_TX  DMA_ADDR_DBI_TDR>;
	pinctrl-names = "default";
	pinctrl-0 = <&mipi_dbi0_typeC_4wire_default>;
	mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
	clock-frequency = <30000000>;
	reset-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

	st7796s: st7796s@0 {
			compatible = "sitronix,st7796s";
			status = "okay";
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			mipi-max-frequency = <25000000>;
			reg = <0>;
			height = <320>;
			width = <480>;
			invert-mode = "1-dot";
			frmctl1 = [80 10];
			bpc = [1F 50 00 20];
			dfc = [8A 07 3B];
			pwr1 = [80 64];
			pwr2 = <0x13>;
			pwr3 = <0xA7>;
			vcmpctl = <0x09>;
			doca = [40 8A 00 00 29 19 A5 38];
			pgc = [F0 06 0B 07 06 05 2E 33 47 3A 17 16 2E 31];
			ngc = [F0 09 0D 09 08 23 2E 33 46 38 13 13 2C 32];
			madctl = <0x28>;
	};
};

&pinctrl {

	/* DBI typeC 4wire mode */
	mipi_dbi0_typeC_4wire_default: mipi_dbi0_typeC_4wire_default {
		group1 {
			pinmux = <GPIO12_DBI_TypeC_SCL>, <GPIO13_DBI_TypeC_CSn>, <GPIO14_DBI_TypeC_SDA0>, <GPIO15_DBI_TypeC_DCn>;
			bias-pull-up;
			input-schmitt-enable;
			drive-strength = <2>;
			input-enable;
		};
	};
};
