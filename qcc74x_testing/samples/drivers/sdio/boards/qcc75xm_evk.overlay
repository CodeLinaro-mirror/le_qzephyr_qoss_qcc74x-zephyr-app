&pinctrl {
	status = "okay";
	sdio_default: sdio_default {
		group1 {
			pinmux = <GPIO48_SDH0_DAT1>,
				<GPIO47_SDH0_DAT0>,
				<GPIO46_SDH0_CLK>,
				<GPIO45_SDH0_CMD>,
				<GPIO44_SDH0_DAT3>,
				<GPIO43_SDH0_DAT2>;
			bias-pull-up;
			drive-strength = <1>;
			input-enable;
			input-schmitt-enable;
		};
	};
};

&sdio {
	status = "okay";
	pinctrl-0 = <&sdio_default>;
	pinctrl-names = "default";	
};
