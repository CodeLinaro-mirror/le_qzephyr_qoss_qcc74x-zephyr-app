&pinctrl {
	status = "okay";
	audio_adc_default: audio_adc_default {
		group1 {
			pinmux = <GPIO27_ADC1_CH3>,
				<GPIO29_ADC1_CH4>;
			input-enable;
			input-schmitt-enable;
			drive-strength = <2>;
		};
	};
	audio_dac_default: audio_dac_default {
		group1 {
			pinmux = <GPIO16_AUDAC_PWM_P>,
				<GPIO14_AUDAC_PWM_N>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&dma {
	status = "okay";
};

&audio_adc {
	status = "okay";
	pinctrl-0 = <&audio_adc_default>;
	pinctrl-names = "default";
	dmas = <&dma 0 DMA_REQUEST_AUADC_RX DMA_ADDR_ADC_RDR>; /* AUADC ?*/
};

&audio_dac {
	status = "okay";
	pinctrl-0 = <&audio_dac_default>;
	pinctrl-names = "default";
	dmas = <&dma 1 DMA_REQUEST_AUDAC_TX DMA_ADDR_DAC_TDR>; /* AUDAC ?*/
};
