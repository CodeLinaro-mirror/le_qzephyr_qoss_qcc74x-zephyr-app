&pinctrl {
	status = "okay";
	audio_dac_default: audio_dac_default {
		group1 {
			pinmux = <GPIO14_AUDAC_PWM_P>,
				<GPIO15_AUDAC_PWM_N>;
			input-schmitt-enable;
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&dma {
	status = "okay";
};

&audio_dac {
	status = "okay";
	pinctrl-0 = <&audio_dac_default>;
	pinctrl-names = "default";
	dmas = <&dma 1 DMA_REQUEST_AUDAC_TX DMA_ADDR_AUDAC_TDR>;
};