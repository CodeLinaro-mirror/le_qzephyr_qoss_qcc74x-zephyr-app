&pinctrl {
	status = "okay";
	spi0_default: spi0_default {
		group1 {
			pinmux = <GPIO29_SPI_SCLK>,
				<GPIO30_SPI_MISO>,
				<GPIO27_SPI_MOSI>,
				<GPIO28_SPI_SS>;
			bias-pull-up;
			drive-strength = <1>;
			input-schmitt-enable;
			input-enable;
		};
	};
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
};
