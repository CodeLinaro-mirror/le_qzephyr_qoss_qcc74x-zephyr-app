/ {
	aliases {
		ethernet0 = &emac0;
	};
};

&emac0 {
	status = "okay";
	phy-connection-type = "rmii";
	ref-clk-output = <0>;
	rx-clk-invert = <1>;
	local-mac-address = [ 18 B9 05 12 34 56 ];
	phy-handle = <&phy0>;

	reset-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>; /* optional */
	pinctrl-0 = <&emac0_default>;
	pinctrl-names = "default";
};

&mdio0 {
	status = "okay";
	clk_div = <39>;
	pinctrl-0 = <&mdio0_default>;
	pinctrl-names = "default";

	phy0: ethernet-phy@1 {
	reg = <1>;  /* PHY 1 - LAN8720, 5 - AR8032 */
	compatible = "ethernet-phy";
	};
};

&pinctrl {
	emac0_default: emac0_default {
	group1 {
		pinmux = <EMAC_REF_CLK_GPIO25>,
			<EMAC_TXD0_GPIO26>,
			<EMAC_TXD1_GPIO27>,
			<EMAC_RXD0_GPIO28>,
			<EMAC_RXD1_GPIO29>,
			<EMAC_RXERR_GPIO30>,
			<EMAC_TX_EN_GPIO31>,
			<EMAC_RX_DV_GPIO32>;
			bias-pull-up;
			input-schmitt-enable;
			drive-strength = <1>;
			input-enable;
		};
	};
	mdio0_default: mdio0_default {
	group1 {
		pinmux = <EMAC_MDC_GPIO33>,
			<EMAC_MDIO_GPIO34>;
			bias-pull-up;
			input-schmitt-enable;
			drive-strength = <1>;
			input-enable;
		};
	};
};
