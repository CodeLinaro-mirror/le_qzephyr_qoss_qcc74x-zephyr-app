/ {
	aliases {
		ethernet0 = &eth_w5500;
	};

	chosen {
		zephyr,net-if-default = &eth_w5500;
	};
};

&pinctrl {
	status = "okay";
	spi0_default: spi0_default {
		group1 {
			pinmux = <SPI0_SCLK_GPIO13>,
				<SPI0_MISO_GPIO10>,
				<SPI0_MOSI_GPIO11>,
				<SPI0_SS_GPIO12>;
			bias-pull-up;
			drive-strength = <2>;
			input-schmitt-enable;
			input-enable;
		};
	};
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";

	eth_w5500: eth-w5500@0 {
		compatible = "wiznet,w5500";
		reg = <0>;					/* CS = 0 */
		spi-max-frequency = <10000000>;			/* 20 MHz max, safe */
		int-gpios = <&gpio0 18 GPIO_ACTIVE_LOW>;	/* Adjust GPIO and polarity */
		reset-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;	/* Reset pin */

		/*zephyr,random-mac-address;*/			/* Generates MAC at boot */
		/*local-mac-address = [ 00 11 22 33 44 55 ];*/	/* Hardcode MAC address */
		status = "okay";
	};
};
