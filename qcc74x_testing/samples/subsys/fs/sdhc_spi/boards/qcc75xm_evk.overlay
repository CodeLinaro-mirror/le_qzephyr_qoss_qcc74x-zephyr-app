&dma {
	status = "okay";
};

&pinctrl {
	status = "okay";
	spi0_default: spi0_default {
		group1 {
			pinmux = <GPIO17_SPI0_SCLK>,
				<GPIO18_SPI0_MISO>,
				<GPIO19_SPI0_MOSI>,
				<GPIO16_SPI0_SS>;
			bias-pull-up;
			drive-strength = <2>;
			input-schmitt-enable;
			input-enable;
		};
	};
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";

	sdhc_spi0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		label = "SDHC_SPI0";
	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		status = "okay";
		label = "SDMMC_0";
		disk-name = "SD";
		};
	spi-max-frequency = <40000000>; /* 40Mhz - Max by spi driver */
	};
};
