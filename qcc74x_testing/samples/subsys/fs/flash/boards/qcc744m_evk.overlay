/delete-node/ &storage_partition;
&flashctrl {
	flash0: flash@A0000000 {
		partitions {
			storage_partition: partition@200000 {
				label = "storage";
				reg = <0x00200000 (0x300000 - 0x2000)>;
			};
			benchmarking_raw: partition@500000 {
				label = "benchmarking_raw";
				reg = <0x00500000 0x00300000>;
			};
		};
	};
};
