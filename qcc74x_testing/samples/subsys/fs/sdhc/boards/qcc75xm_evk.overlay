&sdhc0 {
	status = "okay";
	bus-width = <4>;
	max-bus-freq = <48000000>;
	power-delay-ms = <500>;
	pinctrl-0 = <&sdhc0_default>;
	pinctrl-names = "default";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&pinctrl {
	sdhc0_default: sdhc0_default {
		group1 {
			pinmux = <GPIO48_SDH0_DAT1>,
				<GPIO47_SDH0_DAT0>,
				<GPIO46_SDH0_CLK>,
				<GPIO45_SDH0_CMD>,
				<GPIO44_SDH0_DAT3>,
				<GPIO43_SDH0_DAT2>;
			bias-pull-up;
			input-schmitt-enable;
			drive-strength = <2>;
			input-enable;
		};
	};
};
