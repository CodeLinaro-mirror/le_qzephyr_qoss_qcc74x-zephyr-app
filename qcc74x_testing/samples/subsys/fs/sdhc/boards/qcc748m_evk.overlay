/ {
};

&sdhc0 {
	status = "okay";
	bus-width = <4>;
	min-bus-freq = <400000>;
	max-bus-freq = <25000000>;
	power-delay-ms = <1000>;
	pinctrl-0 = <&sdhc0_default>;
	pinctrl-names = "default";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

&pinctrl {
	sdhc0_default: sdhc0_default {
		group1 {
			pinmux = <SDH_DAT1_GPIO10>,
				<SDH_DAT0_GPIO11>,
				<SDH_CLK_GPIO12>,
				<SDH_CMD_GPIO13>,
				<SDH_DAT3_GPIO14>,
				<SDH_DAT2_GPIO15>;
			bias-pull-up;
			input-schmitt-enable;
			drive-strength = <2>;
			input-enable;
		};
	};
};
