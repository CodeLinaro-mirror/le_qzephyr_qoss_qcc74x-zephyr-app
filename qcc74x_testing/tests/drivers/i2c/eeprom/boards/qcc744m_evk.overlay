/ {

	aliases {
		eeprom0 = &eeprom0;
	};

	chosen {
		zephyr,eeprom = &eeprom0;
	};
};

&pinctrl {
	status = "okay";
	i2c1_default: i2c1_default {
		group1 {
			pinmux = <GPIO18_I2C1_SCL>,
				 <GPIO19_I2C1_SDA>;
			bias-pull-up;
			drive-strength = <1>;
			input-schmitt-enable;
			input-enable;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	eeprom0: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		status = "okay";
		size = <DT_SIZE_K(32)>;
		pagesize = <64>;
		address-width = <16>;
		timeout = <5>;
	};
};
