menu "Zephyr"
source "Kconfig.zephyr"
endmenu

menu "QCC74x Coex Validation"

config WIFI_SHELL_COEX_VALIDATION
	bool "Enable QCC74x Wi-Fi/BLE coexistence validation commands"
	depends on SHELL && QCC74X_WIFI_COEX
	default n
	help
	  Enable the qcc74x_coex shell command group used to validate the
	  sample-level QCC74X Wi-Fi/BLE coexistence runtime.

endmenu
