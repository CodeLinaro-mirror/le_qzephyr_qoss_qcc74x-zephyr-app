#include <zephyr/dt-bindings/pinctrl/qc7xx-qcc74x-pinctrl.h>
#include <zephyr/dt-bindings/dma/qcc74x_dma.h>
/* ------------------------------------------------------------------ */
/*  Pinctrl states                                                       */
/* ------------------------------------------------------------------ */
&pinctrl {
	/* I2C0: GPIO18=SCL, GPIO19=SDA */
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SCL_GPIO18>, <I2C0_SDA_GPIO19>;
			bias-pull-up;
		};
	};
};

/* ------------------------------------------------------------------ */
/*  Peripheral nodes — diagnosis mode: only i2c0 enabled               */
/* ------------------------------------------------------------------ */

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
};

/* SPI0: GPIO13=SCLK, GPIO10=MISO, GPIO11=MOSI, GPIO12=SS */
&pinctrl {
	spi0_default: spi0_default {
		group1 {
			pinmux = <SPI0_SCLK_GPIO13>,
				<SPI0_MISO_GPIO10>,
				<SPI0_MOSI_GPIO11>,
				<SPI0_SS_GPIO12>;
			bias-pull-up;
			drive-strength = <1>;
			input-schmitt-enable;
			input-enable;
		};
	};
};

&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";
};

&dma {
	status = "okay";
};


